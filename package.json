{
  "name": "dsh-review-format-guard",
  "version": "0.1.0",
  "description": "DSH auto-review response format compatibility plugin: strict JSON validation, bounded retries, and preservation of valid denials. / DSH 自动审查返回格式兼容插件：严格校验 JSON、有限重试，保留合法拒绝。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh-CN.md",
    "INSTALL.md",
    "docs",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "INSTALL.en.md",
    "COMPATIBILITY.en.md",
    "CONTRIBUTING.en.md"
  ],
  "scripts": {
    "test": "node --test test/guard.test.mjs test/edge.test.mjs",
    "test:host": "node scripts/run-host-tests.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "MintMilk777",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintMilk777/dsh-review-format-guard.git"
  },
  "homepage": "https://github.com/MintMilk777/dsh-review-format-guard#readme",
  "bugs": {
    "url": "https://github.com/MintMilk777/dsh-review-format-guard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auto-review",
    "json",
    "compatibility",
    "自动审查"
  ]
}
